{
  "name": "veyra-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VEYRA Watchdog — security control plane for autonomous AI agents",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "veyra": "pnpm --filter veyra start",
    "dashboard": "pnpm --filter @veyra/dashboard start",
    "pack:veyra": "pnpm --filter veyra build && pnpm --filter veyra exec npm pack --pack-destination ../.."
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  }
}
