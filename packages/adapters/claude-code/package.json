    "test": "vitest run"
  },
  "dependencies": {
    "@veyra/adapter-core": "workspace:*",
    "@veyra/agent-events": "workspace:*",
    "@veyra/shared": "workspace:*",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
